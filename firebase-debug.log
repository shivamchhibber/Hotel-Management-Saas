[debug] [2026-04-04T13:44:43.315Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/botarmy-hotel-management/rulesets {"name":"projects/botarmy-hotel-management/rulesets/a1f8804f-df2f-437a-b9cd-8559a49d78e0","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function callerUserDoc() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid));\n    }\n\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function getUserRole() {\n      return callerUserDoc().exists ? callerUserDoc().data.role : null;\n    }\n\n    function callerHotelId() {\n      return callerUserDoc().exists ? callerUserDoc().data.hotelId : null;\n    }\n\n    function isSuperAdmin() {\n      return isAuthenticated() && getUserRole() == 'super_admin';\n    }\n\n    function isHotelOwner() {\n      return isAuthenticated() && getUserRole() == 'hotel_owner';\n    }\n\n    function isHotelStaff() {\n      return isAuthenticated() && getUserRole() == 'hotel_staff';\n    }\n\n    function isGuest() {\n      return isAuthenticated() && getUserRole() == 'guest';\n    }\n\n    function ownsHotel(hotelId) {\n      return isHotelOwner() &&\n        exists(/databases/$(database)/documents/hotels/$(hotelId)) &&\n        get(/databases/$(database)/documents/hotels/$(hotelId)).data.ownerId == request.auth.uid;\n    }\n\n    function worksAtHotel(hotelId) {\n      return (isHotelOwner() || isHotelStaff()) &&\n        callerHotelId() != null &&\n        callerHotelId() == hotelId;\n    }\n\n    match /users/{userId} {\n      allow read: if isAuthenticated() && (\n        request.auth.uid == userId ||\n        isSuperAdmin() ||\n        (isHotelOwner() && resource.data.hotelId == callerHotelId())\n      );\n\n      allow create: if isAuthenticated() &&\n        request.auth.uid == userId &&\n        request.resource.data.role == 'guest' &&\n        request.resource.data.uid == userId;\n\n      allow update: if isAuthenticated() && (\n        (request.auth.uid == userId &&\n          exists(/databases/$(database)/documents/users/$(userId)) &&\n          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'hotelId'])) ||\n        isSuperAdmin() ||\n        (isHotelOwner() &&\n          resource.data.hotelId == callerHotelId() &&\n          resource.data.role == 'hotel_staff' &&\n          request.resource.data.role == 'hotel_staff' &&\n          request.resource.data.hotelId == resource.data.hotelId)\n      );\n\n      allow delete: if isSuperAdmin();\n    }\n\n    match /hotels/{hotelId} {\n      allow read: if isAuthenticated() && (\n        isSuperAdmin() ||\n        ownsHotel(hotelId) ||\n        worksAtHotel(hotelId)\n      );\n\n      allow create: if false;\n\n      allow update: if isAuthenticated() && (\n        isSuperAdmin() ||\n        ownsHotel(hotelId)\n      );\n\n      allow delete: if isSuperAdmin();\n    }\n\n    match /guests/{guestId} {\n      allow read: if isAuthenticated() && (\n        (isGuest() && request.auth.uid == guestId) ||\n        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||\n        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||\n        isSuperAdmin()\n      );\n\n      allow create: if isAuthenticated() && (\n        (isHotelOwner() && request.resource.data.hotelId == callerHotelId()) ||\n        (isHotelStaff() && request.resource.data.hotelId == callerHotelId()) ||\n        isSuperAdmin()\n      );\n\n      allow update: if isAuthenticated() && (\n        (isGuest() && request.auth.uid == guestId) ||\n        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||\n        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||\n        isSuperAdmin()\n      );\n\n      allow delete: if isSuperAdmin();\n    }\n\n    match /checkins/{checkinId} {\n      allow read: if isAuthenticated() && (\n        (isGuest() && resource.data.guestId == request.auth.uid) ||\n        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||\n        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||\n        isSuperAdmin()\n      );\n\n      allow create: if isAuthenticated() && (\n        (isHotelOwner() && request.resource.data.hotelId == callerHotelId()) ||\n        (isHotelStaff() && request.resource.data.hotelId == callerHotelId()) ||\n        isSuperAdmin()\n      );\n\n      allow update, delete: if isAuthenticated() && (\n        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||\n        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||\n        isSuperAdmin()\n      );\n    }\n\n    match /checkouts/{checkoutId} {\n      allow read: if isAuthenticated() && (\n        (isGuest() && resource.data.guestId == request.auth.uid) ||\n        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||\n        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||\n        isSuperAdmin()\n      );\n\n      allow create: if isAuthenticated() && (\n        (isHotelOwner() && request.resource.data.hotelId == callerHotelId()) ||\n        (isHotelStaff() && request.resource.data.hotelId == callerHotelId()) ||\n        isSuperAdmin()\n      );\n\n      allow update, delete: if isAuthenticated() && (\n        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||\n        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||\n        isSuperAdmin()\n      );\n    }\n\n    match /activity_logs/{logId} {\n      allow read: if isAuthenticated() && (\n        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||\n        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||\n        isSuperAdmin()\n      );\n\n      allow create: if isAuthenticated() && (\n        (isHotelOwner() && request.resource.data.hotelId == callerHotelId()) ||\n        (isHotelStaff() && request.resource.data.hotelId == callerHotelId()) ||\n        isSuperAdmin()\n      );\n\n      allow update, delete: if isSuperAdmin();\n    }\n\n    match /rooms/{roomId} {\n      allow read: if isAuthenticated() && (\n        isSuperAdmin() ||\n        worksAtHotel(resource.data.hotelId)\n      );\n\n      allow create: if isAuthenticated() && (\n        isSuperAdmin() ||\n        (isHotelOwner() && ownsHotel(request.resource.data.hotelId))\n      );\n\n      allow update: if isAuthenticated() && (\n        isSuperAdmin() ||\n        (isHotelOwner() && ownsHotel(resource.data.hotelId)) ||\n        (isHotelStaff() && worksAtHotel(resource.data.hotelId))\n      );\n\n      allow delete: if isAuthenticated() && (\n        isSuperAdmin() ||\n        (isHotelOwner() && ownsHotel(resource.data.hotelId))\n      );\n    }\n\n    match /staff_actions/{actionId} {\n      allow read: if isAuthenticated() && (\n        isSuperAdmin() ||\n        worksAtHotel(resource.data.hotelId)\n      );\n\n      allow create: if isAuthenticated() && (\n        isSuperAdmin() ||\n        worksAtHotel(request.resource.data.hotelId)\n      );\n\n      allow update, delete: if isAuthenticated() && (\n        isSuperAdmin() ||\n        (isHotelOwner() && ownsHotel(resource.data.hotelId))\n      );\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-04-04T13:44:43.172703Z","metadata":{"services":["cloud.firestore"]}}
