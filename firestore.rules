rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function callerUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return callerUserDoc().exists ? callerUserDoc().data.role : null;
    }

    function callerHotelId() {
      return callerUserDoc().exists ? callerUserDoc().data.hotelId : null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }

    function isHotelOwner() {
      return isAuthenticated() && getUserRole() == 'hotel_owner';
    }

    function isHotelStaff() {
      return isAuthenticated() && getUserRole() == 'hotel_staff';
    }

    function isGuest() {
      return isAuthenticated() && getUserRole() == 'guest';
    }

    function ownsHotel(hotelId) {
      return isHotelOwner() &&
        exists(/databases/$(database)/documents/hotels/$(hotelId)) &&
        get(/databases/$(database)/documents/hotels/$(hotelId)).data.ownerId == request.auth.uid;
    }

    function worksAtHotel(hotelId) {
      return (isHotelOwner() || isHotelStaff()) &&
        callerHotelId() != null &&
        callerHotelId() == hotelId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (isHotelOwner() && resource.data.hotelId == callerHotelId())
      );

      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'guest' &&
        request.resource.data.uid == userId;

      allow update: if isAuthenticated() && (
        (request.auth.uid == userId &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'hotelId'])) ||
        isSuperAdmin() ||
        (isHotelOwner() &&
          resource.data.hotelId == callerHotelId() &&
          resource.data.role == 'hotel_staff' &&
          request.resource.data.role == 'hotel_staff' &&
          request.resource.data.hotelId == resource.data.hotelId)
      );

      allow delete: if isSuperAdmin();
    }

    match /hotels/{hotelId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        ownsHotel(hotelId) ||
        worksAtHotel(hotelId)
      );

      allow create: if false;

      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        ownsHotel(hotelId)
      );

      allow delete: if isSuperAdmin();
    }

    match /guests/{guestId} {
      allow read: if isAuthenticated() && (
        (isGuest() && request.auth.uid == guestId) ||
        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||
        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        (isHotelOwner() && request.resource.data.hotelId == callerHotelId()) ||
        (isHotelStaff() && request.resource.data.hotelId == callerHotelId()) ||
        isSuperAdmin()
      );

      allow update: if isAuthenticated() && (
        (isGuest() && request.auth.uid == guestId) ||
        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||
        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||
        isSuperAdmin()
      );

      allow delete: if isSuperAdmin();
    }

    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (
        (isGuest() && resource.data.guestId == request.auth.uid) ||
        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||
        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        (isHotelOwner() && request.resource.data.hotelId == callerHotelId()) ||
        (isHotelStaff() && request.resource.data.hotelId == callerHotelId()) ||
        isSuperAdmin()
      );

      allow update, delete: if isAuthenticated() && (
        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||
        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||
        isSuperAdmin()
      );
    }

    match /checkouts/{checkoutId} {
      allow read: if isAuthenticated() && (
        (isGuest() && resource.data.guestId == request.auth.uid) ||
        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||
        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        (isHotelOwner() && request.resource.data.hotelId == callerHotelId()) ||
        (isHotelStaff() && request.resource.data.hotelId == callerHotelId()) ||
        isSuperAdmin()
      );

      allow update, delete: if isAuthenticated() && (
        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||
        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||
        isSuperAdmin()
      );
    }

    match /activity_logs/{logId} {
      allow read: if isAuthenticated() && (
        (isHotelOwner() && resource.data.hotelId == callerHotelId()) ||
        (isHotelStaff() && resource.data.hotelId == callerHotelId()) ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        (isHotelOwner() && request.resource.data.hotelId == callerHotelId()) ||
        (isHotelStaff() && request.resource.data.hotelId == callerHotelId()) ||
        isSuperAdmin()
      );

      allow update, delete: if isSuperAdmin();
    }

    match /rooms/{roomId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        worksAtHotel(resource.data.hotelId)
      );

      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (isHotelOwner() && ownsHotel(request.resource.data.hotelId))
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (isHotelOwner() && ownsHotel(resource.data.hotelId)) ||
        (isHotelStaff() && worksAtHotel(resource.data.hotelId))
      );

      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (isHotelOwner() && ownsHotel(resource.data.hotelId))
      );
    }

    match /staff_actions/{actionId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        worksAtHotel(resource.data.hotelId)
      );

      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        worksAtHotel(request.resource.data.hotelId)
      );

      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (isHotelOwner() && ownsHotel(resource.data.hotelId))
      );
    }
  }
}
